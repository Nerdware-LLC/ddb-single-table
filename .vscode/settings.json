{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.unicodeHighlight.allowedCharacters": {
    "️–": true
  },
  "eslint.codeActionsOnSave.mode": "all",
  "eslint.codeActionsOnSave.rules": ["!prefer-const", "*"], // When I say `let`, I mean `let`!
  "eslint.format.enable": false,
  "explorer.sortOrder": "type",
  "explorer.sortOrderLexicographicOptions": "upper",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "search.exclude": {
    "package-lock.json": true,
    "**/CHANGELOG.md": true,
    "**/.git/**": true,
    "**/.tsbuildinfo/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "vsicons.associations.files": [
    // https://github.com/vscode-icons/vscode-icons/blob/master/src/iconsManifest/supportedExtensions.ts
    {
      "icon": "tsconfig",
      "extensions": [],
      "filenamesGlob": ["tsconfig", "tsconfig.build-cjs", "tsconfig.build-esm"],
      "extensionsGlob": ["json"],
      "filename": true,
      "format": "svg"
    },
    {
      "icon": "vitest",
      "filenamesGlob": ["vitest.config", "vitest.setup"],
      "extensions": [],
      "extensionsGlob": ["ts"],
      "filename": true,
      "languages": ["vitestsnapshot"],
      "format": "svg"
    }
  ]
}
